# Not wired up yet (see src/config/env.ts's note on why - no
# react-native-config dependency added for Phase 2/3). This file documents
# the values that constant currently hardcodes; edit env.ts directly for
# now, and treat this as the reference for when env injection is added.

# Live backend (default - see repo root deployment notes / README.md
# "Deploying the backend" section):
API_BASE_URL=https://raillens-train-db.onrender.com/api/v1

# Local backend dev only (emulator/simulator on the same machine as a
# `train-db` you're running locally - set USE_LOCAL_BACKEND=true in env.ts
# to use these instead):
API_BASE_URL_ANDROID_EMULATOR=http://10.0.2.2:8080/api/v1
API_BASE_URL_IOS_SIMULATOR=http://localhost:8080/api/v1
